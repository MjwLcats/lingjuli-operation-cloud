<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lingjuli</groupId>
    <artifactId>lingjuli-operation-cloud-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
        <spring-boot.version>3.2.4</spring-boot.version>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <module>dependencies/lingjuli-dependencies</module>
        <module>foundations/lingjuli-foundation-core</module>
        <module>foundations/lingjuli-foundation-webmvc</module>
        <module>foundations/lingjuli-foundation-webflux</module>
        <module>foundations/lingjuli-foundation-security</module>
        <module>foundations/lingjuli-foundation-tenant</module>
        <module>foundations/lingjuli-foundation-jdbc</module>
        <module>foundations/lingjuli-foundation-redis</module>
        <module>foundations/lingjuli-foundation-observability</module>
        <module>foundations/lingjuli-foundation-openapi</module>
        <module>foundations/lingjuli-foundation-test</module>
        <module>gateways/lingjuli-gateway-service</module>
        <module>gateways/lingjuli-open-gateway-service</module>
        <module>platform-services/lingjuli-tenant-service</module>
        <module>platform-services/lingjuli-identity-service</module>
        <module>platform-services/lingjuli-authorization-service</module>
        <module>platform-services/lingjuli-organization-service</module>
        <module>platform-services/lingjuli-store-service</module>
        <module>business-services/lingjuli-sales-service</module>
        <module>business-services/lingjuli-dish-service</module>
        <module>business-services/lingjuli-workforce-service</module>
        <module>business-services/lingjuli-attendance-service</module>
        <module>business-services/lingjuli-inspection-service</module>
        <module>query-services/lingjuli-dashboard-service</module>
        <module>query-services/lingjuli-reporting-service</module>
        <module>intelligence-services/lingjuli-prediction-service</module>
        <module>intelligence-services/lingjuli-ai-service</module>
        <module>intelligence-services/lingjuli-knowledge-service</module>
        <module>capability-services/lingjuli-notification-service</module>
        <module>capability-services/lingjuli-file-service</module>
        <module>capability-services/lingjuli-scheduler-service</module>
        <module>integration-services/lingjuli-integration-contract</module>
        <module>integration-services/lingjuli-integration-core</module>
        <module>integration-services/lingjuli-integration-pos</module>
        <module>integration-services/lingjuli-integration-hr</module>
        <module>integration-services/lingjuli-integration-finance</module>
        <module>architecture-tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
